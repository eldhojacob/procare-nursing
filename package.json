{
  "name": "procare-nursing-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static marketing and intake website for Procare Nursing, a Sydney-based DVA-contracted Community Nursing provider.",
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"npm:serve\"",
    "watch:css": "tailwindcss -i ./src/input.css -o ./dist/styles.css --watch",
    "serve": "http-server . -p 8080 -c-1",
    "build": "tailwindcss -i ./src/input.css -o ./dist/styles.css --minify"
  },
  "keywords": [
    "static-site",
    "tailwindcss",
    "dva",
    "community-nursing"
  ],
  "author": "Procare Nursing",
  "license": "UNLICENSED",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "http-server": "^14.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
